# ==============================================================================
# Arquivo de Configuração de Segurança e Notificações (Template)
# Copie este arquivo para 'config.env' ou exporte as variáveis no ambiente.
# ==============================================================================

# Notificações via Telegram Bot
TELEGRAM_BOT_TOKEN="seu_token_aqui"
TELEGRAM_CHAT_ID="seu_chat_id_aqui"

# Integração AbuseIPDB & Cloudflare WAF Lists
ABUSEIPDB_API_KEY="sua_chave_abuseipdb"
CLOUDFLARE_EMAIL="seu_email_cloudflare@exemplo.com"
CLOUDFLARE_API_KEY="sua_chave_global_ou_token"
CLOUDFLARE_ACCOUNT_ID="seu_account_id"
CLOUDFLARE_LIST_ID="seu_list_id_regras_waf"
ABUSE_CONFIDENCE_MINIMUM=90
ABUSE_IP_LIMIT=10000

# E-mail para relatórios de pacotes e contingência
SECURITY_ALERT_EMAIL="admin@exemplo.com"

